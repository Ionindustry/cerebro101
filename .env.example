# Copia este fichero a .env y rellena los valores.
CEREBRO_MODO=produccion            # «desarrollo» permite probar sin Keycloak
PERFIL_HARDWARE=pequena            # minima (6–8 GB) | mediana (10–12 GB) | pequena (16 GB) | grande (24 GB o más); desplegar.sh lo elige solo
TZ=Europe/Madrid
# Ollama y voz según la tarjeta (los fija desplegar.sh; peticiones simultáneas × contexto = memoria de vídeo)
#OLLAMA_NUM_PARALLEL=4
#OLLAMA_MAX_LOADED_MODELS=3
#WHISPER_MODELO=large-v3-turbo      # small con tarjetas de 12 GB o menos
#WHISPER_DISPOSITIVO=cuda           # cpu si no queda memoria de vídeo
#PIPER_VOZ_ES=/voces/es_ES-sharvard-medium.onnx   # voz de salida de Jarvis en castellano (por defecto davefx, masculina); ver docs/VOZ.md
#PIPER_LOCUTOR_ES=F                               # locutor, si la voz tiene varios (sharvard: M y F)
#PIPER_VOZ_CA=                                    # catalán (por defecto upc_ona, femenina)
#PIPER_LOCUTOR_CA=

# Propietario de la base de datos: solo lo usa el servicio «migraciones»; la API no lo recibe.
POSTGRES_PASSWORD=cambia-esto
# Rol cerebro_app (mínimo privilegio) con el que entran la API, el worker y beat
CEREBRO_APP_PASSWORD=cambia-esto
REDIS_URL=redis://redis:6379/0
OLLAMA_URL=http://ollama:11434
# Qué hacer cuando el modelo de IA va lento o se cae (valores por defecto; ver docs/ARQUITECTURA.md)
#OLLAMA_TIMEOUT=300                # segundos máximos esperando una respuesta
#OLLAMA_TIMEOUT_CONEXION=10        # segundos máximos para conectar
#OLLAMA_TIMEOUT_EMBEDDINGS=120     # segundos máximos para calcular embeddings
#OLLAMA_REINTENTOS=2               # reintentos ante fallos transitorios (con espera de 1, 2, 4… s); un timeout no se reintenta
#OLLAMA_CONCURRENCIA=2             # llamadas simultáneas por proceso
#OLLAMA_ESPERA_MAX=120             # segundos que una petición espera su turno antes de responder «ocupado»
#OLLAMA_NUM_CTX=8192              # ventana de contexto en tokens (Ollama usaría 4096 y recortaría en silencio las instrucciones); sube con GPU de 24 GB
#OLLAMA_PENSAR=false              # true activa el razonamiento de modelos como qwen3.5: gasta tokens y tiempo, y corta las respuestas si el tope es bajo
#OLLAMA_PENALIZACION_PRESENCIA=0       # 0 por defecto: el valor de fábrica de Qwen (1,5) hace que el modelo derive a otros idiomas
#OLLAMA_RESULTADO_MAX=6000        # caracteres máximos de un resultado de herramienta que ve el modelo
#OLLAMA_MAX_TOKENS=4096            # tope de salida: evita que un modelo en bucle genere hasta agotar el tiempo
#OLLAMA_FALLOS_CIRCUITO=3          # fallos de conexión seguidos que abren el cortacircuitos
#OLLAMA_ENFRIAMIENTO=20            # segundos que el cortacircuitos responde «no disponible» al instante

# ERPNext (instalación aparte con frappe_docker). Un token por departamento: «api_key:api_secret»
ERPNEXT_URL=http://erpnext:8080
# Instalación propia de ERPNext (erpnext/docker-compose.yml)
ERPNEXT_SITE=erp.101.cat
ERPNEXT_DB_ROOT_PASSWORD=cambia-esto
ERPNEXT_ADMIN_PASSWORD=cambia-esto
ERPNEXT_TOKEN=
ERPNEXT_TOKEN_DIRECCION=            # lo crea scripts/erpnext_usuario_tecnico.py (lectura de clientes, proveedores y empleados)
ERPNEXT_TOKEN_FINANZAS=
ERPNEXT_TOKEN_COMERCIAL=
ERPNEXT_TOKEN_OPERACIONES=
ERPNEXT_TOKEN_TELECOM=
ERPNEXT_TOKEN_AREAS=
ERPNEXT_TOKEN_ATENCION=
ERPNEXT_TOKEN_LEGAL=
ERPNEXT_TOKEN_LICITACIONES=
ERPNEXT_TOKEN_MARKETING=
ERPNEXT_TOKEN_PERSONAS=
ERPNEXT_TOKEN_TECNOLOGIA=

# Servicios externos (solo reciben datos de sensibilidad baja)
XAI_API_KEY=
XAI_MODELO=grok-4

# Modelos externos para consultas complejas (Claude y ChatGPT). Se ponen con: python3 scripts/modelos_activar.py claude|chatgpt
# y se conectan o desconectan desde el panel (Agentes). Solo reciben datos anonimizados y de agentes de sensibilidad baja/media.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_MODELO=                      # vacío = el de config/modelos_externos.yaml
CHATGPT_MODELO=
#ANONIMIZACION_MODELO_SPACY=es_core_news_md   # solo con ANONIMIZACION_NER=spacy
ANONIMIZACION_NER=heuristico                      # heuristico | spacy (necesita spaCy y su modelo es_core_news_md)
USAR_JEV_NUBE=false                # true: Jev en la nube (solo datos de sensibilidad baja/anonimizados)
JEV_URL=https://api.typesafe.ai
JEV_API_KEY=                       # clave de console.typesafe.ai; sin ella se usa el modelo local
JEFF_URL=http://jeff:8080

AGENT_REACH_URL=http://agent-reach:8090
#SEARXNG_URL=http://searxng:8080     # buscador propio de Jarvis (internet); lo arranca docker compose
#SEARXNG_SECRET=                      # opcional: clave interna de SearXNG (solo red interna)

# Correo (IMAP/SMTP) y calendario (CalDAV) del servidor propio. Servidores en config/integraciones.yaml.
# Buzones de correo de la empresa: config/buzones.yaml; las contraseñas van en secretos/buzones.env (docs/CORREO.md), no aquí
CALENDARIO_USUARIO=cerebro@101.cat
CALENDARIO_CLAVE=

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_URL_PUBLICA=http://localhost:8080   # la dirección de Keycloak que ve el navegador (en producción, su https)
PANEL_URL=http://localhost:3000              # dirección pública del panel (debe estar en las URI del cliente de Keycloak)
PANEL_USUARIO_DESARROLLO=                    # solo pruebas: entra sin Keycloak con ese nombre (CEREBRO_MODO=desarrollo)
# Sesiones del panel en un Redis propio: contraseña de ese Redis y clave con la que se cifran las sesiones.
# Vacías = sesiones en memoria (se pierden al reiniciar el panel); en producción las genera despliegue/desplegar.sh
PANEL_REDIS_PASSWORD=
PANEL_SESION_SECRET=
KEYCLOAK_REALM=cerebro
KEYCLOAK_CLIENTE=cerebro-panel
KEYCLOAK_ADMIN_PASSWORD=cambia-esto

LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_URL_PUBLICA=http://localhost:3001      # dirección de Langfuse que ve el navegador
# Claves del proyecto «Cerebro»: inventadlas aquí (pk-lf-… / sk-lf-…) y Langfuse las crea al arrancar por primera vez
LANGFUSE_PUBLIC_KEY=pk-lf-cambia-esto
LANGFUSE_SECRET_KEY=sk-lf-cambia-esto
# Usuario administrador de Langfuse (se crea solo la primera vez)
LANGFUSE_INIT_USER_EMAIL=admin@101.cat
LANGFUSE_INIT_USER_PASSWORD=cambia-esto
# Langfuse v3: PostgreSQL + ClickHouse + Redis + MinIO. Todas con contraseñas propias.
LANGFUSE_DB_PASSWORD=cambia-esto
LANGFUSE_CLICKHOUSE_PASSWORD=cambia-esto
LANGFUSE_MINIO_PASSWORD=cambia-esto
LANGFUSE_REDIS_PASSWORD=cambia-esto
LANGFUSE_NEXTAUTH_SECRET=cambia-esto
LANGFUSE_SALT=cambia-esto
LANGFUSE_REGISTRAR_CONTENIDO=true                # false: solo metadatos, sin los textos de las llamadas (ver docs/SEGURIDAD.md)
LANGFUSE_ENCRYPTION_KEY=                         # 64 caracteres hexadecimales: openssl rand -hex 32


# --- Despliegue en producción (despliegue/desplegar.sh rellena esto con la opción --dominio)
DOMINIO=
CORREO_ADMIN=                                   # para los avisos de caducidad de certificados
TLS_MODO=letsencrypt                            # letsencrypt (DNS público y puertos 80/443 abiertos) | interno (intranet; Caddy firma con su propia CA)
DOM_PANEL=
DOM_AUTH=
DOM_ERP=
DOM_TRAZAS=
IPS_ADMIN=private_ranges                        # desde dónde se puede abrir la consola de administración de Keycloak (IP, rangos CIDR o private_ranges)
KEYCLOAK_DB_PASSWORD=cambia-esto

# --- Motor de licitaciones (licitaciones/compose.yaml): almacén de originales y bus de eventos. Credenciales propias de cada servicio.
LIC_S3_USUARIO=lic-s3
LIC_S3_PASSWORD=cambia-esto
LIC_NATS_USUARIO=lic-nats
LIC_NATS_PASSWORD=cambia-esto
LIC_PG_PASSWORD=cambia-esto
LIC_API_TOKEN=cambia-esto                       # token de la API del motor: mínimo 32 caracteres (openssl rand -hex 32)
# El Cerebro (herramienta «licitaciones» y sección del panel) usa por defecto LIC_API_TOKEN y http://licitaciones-api:8080; solo hay que fijarlas aquí
# si cambian. Para que el Cerebro vea el motor, arráncalo también con licitaciones/compose.cerebro.yaml (ver licitaciones/README.md).
#LICITACIONES_API_URL=
#LICITACIONES_API_TOKEN=
LIC_FUENTES=placsp-643                          # placsp-643, placsp-1044, placsp-1143 (separadas por comas)
LIC_INTERVALO=1h                                # cada cuánto se consulta la fuente (mínimo 5m)
LIC_CONTACTO=                                   # correo o web que se anuncia a la fuente en el User-Agent (recomendado)
LIC_HISTORICO_DESDE=                            # carga el histórico en ZIP desde aquí: 2023 o 2023-06 (vacío = no; ver licitaciones/README.md, «Histórico antiguo»)
